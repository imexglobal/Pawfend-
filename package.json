{
  "name": "petneighbor",
  "version": "1.0.0",
  "private": true,
  "description": "PetNeighbor (Pawfend) — neighborhood pet care for iOS, Android, and the web.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "npm run icons && npm run build && cap sync",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5"
  }
}
